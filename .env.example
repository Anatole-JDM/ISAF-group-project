# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
# TabPFN >= 9 needs a token AND a one-time licence acceptance:
#   1. https://ux.priorlabs.ai  -> log in
#   2. Licenses tab -> accept the TabPFN 3.5 licence   <- separate from the token
#   3. Account page -> copy API key
TABPFN_TOKEN=

# Which checkpoint the foundation-model arm uses. Default V2 = ungated, no
# account, no licence, works for everyone on the team with zero setup.
# Set V3_5 only if you have already accepted the PriorLabs licence and
# downloaded the 876 MB weights.
# TABPFN_VERSION=V3_5

# Only needed if your home directory is not writable (CI, sandboxes):
# SKB_DATA_DIRECTORY=/tmp/skrub_data
# TABPFN_MODEL_CACHE_DIR=/tmp/tabpfn_models
# HF_HOME=/tmp/hf
